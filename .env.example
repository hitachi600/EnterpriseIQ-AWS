# ==============================================================================
# EnterpriseIQ - Environment Configuration Template
# ==============================================================================

# Deployment Environment [dev | staging | prod]
ENVIRONMENT=dev

# AWS Region (Primary: us-east-1 / Secondary for DR: us-west-2 or ap-south-1/ap-south-2)
AWS_REGION=us-east-1

# Amazon Bedrock Foundation Models
BEDROCK_MODEL_ID_PRIMARY=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_ID_FAST=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Amazon Bedrock Knowledge Base & Guardrails
BEDROCK_KNOWLEDGE_BASE_ID=NEXORAKB-DEV-01
BEDROCK_GUARDRAIL_ID=nexora-ai-guardrail-v1
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Storage & Persistence (S3 & DynamoDB)
S3_DOCUMENT_VAULT_BUCKET=nexora-enterprise-kb-vault-dev
S3_STAGING_QUARANTINE_BUCKET=nexora-enterprise-staging-quarantine-dev
DYNAMODB_SINGLE_TABLE_NAME=EnterpriseIQ-Core-State-dev
KMS_KEY_ALIAS=alias/enterpriseiq-document-vault-dev

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_DevUserPool
COGNITO_APP_CLIENT_ID=nexora-app-client-dev-01

# RAG Hyperparameters
RAG_TOP_K_CHUNKS=4
RAG_MIN_SIMILARITY_SCORE=0.72
MAX_GENERATION_TOKENS=768
TEMPERATURE=0.1
